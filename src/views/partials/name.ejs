main>
        <h1><%= title %></h1>
        <h2>Upcoming Service Projects</h2>
     
        <div class="projects-grid">
    <% if (projects && projects.length > 0) { %>
        <% projects.forEach(project => { %>
            <div class="project-card">
                <!-- Line 1: Project Title (Organization Name) -->
                <h3 class="project-name">
                    <%= project.title %>  (<%= project.org_name %>)
                </h3>
                
                
                
                
            </div>
        <% }); %>
    <% } else { %>
        <p class="no-data">No upcoming service projects found.</p>
    <% } %>
</div>

    </main>